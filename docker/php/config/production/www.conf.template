[www]
listen = 9000
listen.allowed_clients = any

pm = dynamic

pm.max_children = __MAX_CHILDREN__
pm.start_servers = __START_SERVERS__
pm.min_spare_servers = __MIN_SPARE_SERVERS__
pm.max_spare_servers = __MAX_SPARE_SERVERS__
pm.max_requests = 500

catch_workers_output = yes
decorate_workers_output = no
clear_env = no

request_terminate_timeout = 180s
request_slowlog_timeout = 5s

slowlog = /proc/self/fd/2

ping.path = /fpm-ping
ping.response = pong

pm.status_path = /fpm-status

access.log = /proc/self/fd/2
access.format = "%R - %u %t \"%m %r\" %s %{milliseconds}dms %{megabytes}MMB"

rlimit_files = 65535

php_admin_value[error_log] = /proc/self/fd/2
php_admin_flag[log_errors] = on
php_admin_flag[display_errors] = off