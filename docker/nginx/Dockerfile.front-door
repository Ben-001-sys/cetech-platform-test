# syntax=docker/dockerfile:1.7

FROM nginx:1.30.4

USER root

RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends curl; \
    rm -rf /var/lib/apt/lists/*; \
    mkdir -p \
      /tmp/nginx/client_temp \
      /tmp/nginx/proxy_temp \
      /tmp/nginx/fastcgi_temp; \
    chown -R nginx:nginx /tmp/nginx

COPY docker/nginx/nginx.production.conf \
  /etc/nginx/nginx.conf

COPY docker/nginx/front-door/production.conf \
  /etc/nginx/conf.d/default.conf

USER nginx:nginx

EXPOSE 8080

STOPSIGNAL SIGQUIT

HEALTHCHECK \
  --interval=10s \
  --timeout=3s \
  --start-period=10s \
  --retries=5 \
  CMD curl -fsS http://127.0.0.1:8080/__health/live \
      || exit 1

CMD ["nginx", "-g", "daemon off;"]