# syntax=docker/dockerfile:1.7

ARG PHP_RELEASE_IMAGE
FROM ${PHP_RELEASE_IMAGE} AS release

FROM nginx:1.30.4

ARG SITE_CONFIG

COPY docker/nginx/nginx.production.conf \
  /etc/nginx/nginx.conf

COPY docker/nginx/common/ \
  /etc/nginx/snippets/

COPY docker/nginx/${SITE_CONFIG}/default.conf \
  /etc/nginx/conf.d/default.conf

COPY --from=release \
  /opt/cetech/release \
  /opt/cetech/release

RUN set -eux; \
    rm -f /etc/nginx/conf.d/example_ssl.conf; \
    mkdir -p \
      /tmp/nginx/client_temp \
      /tmp/nginx/proxy_temp \
      /tmp/nginx/fastcgi_temp \
      /tmp/nginx/uwsgi_temp \
      /tmp/nginx/scgi_temp; \
    chown -R nginx:nginx \
      /tmp/nginx \
      /opt/cetech/release

USER root

RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends curl; \
    rm -rf /var/lib/apt/lists/*

USER nginx:nginx

EXPOSE 8080

STOPSIGNAL SIGQUIT

HEALTHCHECK \
  --interval=15s \
  --timeout=5s \
  --start-period=10s \
  --retries=5 \
  CMD curl -fsS http://127.0.0.1:8080/__health/live \
      || exit 1

CMD ["nginx", "-g", "daemon off;"]
